{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wu2c-peter/howsteep/schema/ocl-climb.schema.json",
  "title": "OpenClimb Ladder climb document",
  "type": "object",
  "required": [
    "ocl_version",
    "name",
    "slug",
    "length_m",
    "endpoint_gain_m",
    "overall_gradient_pct",
    "ladder",
    "provenance"
  ],
  "properties": {
    "ocl_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "length_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "endpoint_gain_m": {
      "type": "number"
    },
    "overall_gradient_pct": {
      "type": "number"
    },
    "accumulated_ascent_m": {
      "type": "number"
    },
    "confidence": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "U"
      ]
    },
    "quality_grade": false,
    "ladder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "window_m",
          "max_gradient_pct",
          "diagnostic"
        ],
        "properties": {
          "window_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_gradient_pct": {
            "type": "number"
          },
          "min_gradient_pct": {
            "type": "number"
          },
          "diagnostic": {
            "type": "boolean"
          },
          "start_distance_m": {
            "type": "number"
          },
          "end_distance_m": {
            "type": "number"
          },
          "start_elevation_m": {
            "type": "number"
          },
          "end_elevation_m": {
            "type": "number"
          },
          "placement_sensitivity_pp": {
            "type": "number",
            "description": "How far this window's maximum moves (percentage points) when the measured line is offset laterally within the carriageway. Large values mean the elevation model cannot resolve the road surface here and the maximum is sensitive to line placement."
          },
          "estimated_range_pct": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Plausible range for this window's maximum where the measured value is placement-sensitive. Derived from a longer, stable window on the same climb and how gradient concentrates on comparable well-resolved roads in this survey. Present only when placement sensitivity makes a single figure false precision."
          },
          "estimated_best_pct": {
            "type": "number",
            "description": "Central estimate within estimated_range_pct."
          },
          "estimate_basis": {
            "type": "string",
            "description": "How the estimate was derived: the anchor window used and the number of comparable roads behind the ratio. A statistical norm from this survey's own well-resolved pages, not an independent ground survey."
          }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "analysis_version",
        "road_source",
        "elevation_provider",
        "elevation_resolution_m",
        "elevation_crs",
        "sample_interval_m",
        "interpolation"
      ],
      "properties": {
        "analysis_version": {
          "type": "string"
        },
        "road_source": {
          "type": "string"
        },
        "elevation_provider": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": "string"
        },
        "elevation_resolution_m": {
          "type": "number"
        },
        "elevation_crs": {
          "type": "string"
        },
        "sample_interval_m": {
          "type": "number"
        },
        "interpolation": {
          "type": "string"
        },
        "smoothing": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "reported_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_name",
          "value_pct",
          "evidence_type"
        ],
        "properties": {
          "source_name": {
            "type": "string"
          },
          "value_pct": {
            "type": "number"
          },
          "evidence_type": {
            "enum": [
              "road_sign",
              "event_description",
              "cycling_database",
              "gps_segment",
              "manual_measurement",
              "inclinometer",
              "survey",
              "mapper_estimate",
              "other"
            ]
          },
          "claimed_window_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "credibility": {
            "type": "string"
          },
          "observed_via": {
            "enum": [
              "in_person",
              "photo",
              "osm_tag_history"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "max_gradient": false,
    "max_gradient_pct": false,
    "maximum_gradient": false
  },
  "additionalProperties": true
}
